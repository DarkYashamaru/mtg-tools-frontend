<script setup lang="ts">
import { computed, onBeforeUnmount, ref, watch } from 'vue'
import type {
  BasicLandAdjustment,
  CollectionRecord,
  ManaColorCounts,
} from './types'

const COLOR_ORDER = ['W', 'U', 'B', 'R', 'G', 'C'] as const
type ManaColor = typeof COLOR_ORDER[number]

const props = defineProps<{
  open: boolean
  collection: CollectionRecord
  authHeaders: Record<string, string>
}>()

const emit = defineEmits<{
  close: []
  applied: [collection: CollectionRecord, adjustment: BasicLandAdjustment]
  unauthorized: []
}>()

const targetLandCount = ref(38)
const preview = ref<BasicLandAdjustment | null>(null)
const previewError = ref('')
const isLoadingPreview = ref(false)
const isApplying = ref(false)
let previewTimer: ReturnType<typeof window.setTimeout> | null = null
let previewRequestId = 0

const isTargetValid = computed(() => (
  Number.isInteger(targetLandCount.value)
  && targetLandCount.value >= 0
  && targetLandCount.value <= 99
))

const visibleColors = computed(() => COLOR_ORDER.filter((color) => {
  const adjustment = preview.value
  return adjustment?.eligible_colors.includes(color)
    || (adjustment?.current_basics[color] ?? 0) > 0
    || (adjustment?.proposed_basics[color] ?? 0) > 0
}))

function clearPreviewTimer() {
  if (previewTimer !== null) {
    window.clearTimeout(previewTimer)
    previewTimer = null
  }
}

function handleUnauthorized() {
  previewRequestId += 1
  emit('unauthorized')
}

async function requestPreview() {
  if (!props.open || !isTargetValid.value) {
    isLoadingPreview.value = false
    preview.value = null
    previewError.value = isTargetValid.value ? '' : 'Enter a whole number between 0 and 99.'
    return
  }

  const requestId = ++previewRequestId
  isLoadingPreview.value = true
  previewError.value = ''

  try {
    const response = await fetch(
      `/api/collections/${props.collection.id}/basic-lands/preview`,
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...props.authHeaders,
        },
        body: JSON.stringify({ target_land_count: targetLandCount.value }),
      },
    )
    const data = await response.json().catch(() => ({}))
    if (requestId !== previewRequestId) return
    if (response.status === 401) {
      handleUnauthorized()
      return
    }
    if (!response.ok || !data.success || !data.adjustment) {
      throw new Error(data.error || 'Unable to preview the basic-land adjustment.')
    }
    preview.value = data.adjustment as BasicLandAdjustment
  } catch (error) {
    if (requestId === previewRequestId) {
      preview.value = null
      previewError.value = error instanceof Error
        ? error.message
        : 'Unable to preview the basic-land adjustment.'
    }
  } finally {
    if (requestId === previewRequestId) {
      isLoadingPreview.value = false
    }
  }
}

function schedulePreview() {
  clearPreviewTimer()
  previewTimer = window.setTimeout(() => {
    void requestPreview()
  }, 250)
}

async function applyAdjustment() {
  if (!preview.value || !isTargetValid.value || isApplying.value) return

  isApplying.value = true
  previewError.value = ''
  try {
    const response = await fetch(
      `/api/collections/${props.collection.id}/basic-lands/adjust`,
      {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...props.authHeaders,
        },
        body: JSON.stringify({ target_land_count: targetLandCount.value }),
      },
    )
    const data = await response.json().catch(() => ({}))
    if (response.status === 401) {
      handleUnauthorized()
      return
    }
    if (!response.ok || !data.success || !data.collection || !data.adjustment) {
      throw new Error(data.error || 'Unable to adjust basic lands.')
    }
    emit(
      'applied',
      data.collection as CollectionRecord,
      data.adjustment as BasicLandAdjustment,
    )
  } catch (error) {
    previewError.value = error instanceof Error
      ? error.message
      : 'Unable to adjust basic lands.'
  } finally {
    isApplying.value = false
  }
}

function closeModal() {
  if (!isApplying.value) emit('close')
}

function colorValue(counts: ManaColorCounts, color: ManaColor) {
  return counts[color] ?? 0
}

watch(
  () => [props.open, props.collection.id] as const,
  ([open], previous) => {
    clearPreviewTimer()
    if (!open) {
      previewRequestId += 1
      preview.value = null
      previewError.value = ''
      isLoadingPreview.value = false
      return
    }
    if (!previous?.[0]) targetLandCount.value = 38
    void requestPreview()
  },
  { immediate: true },
)

watch(targetLandCount, () => {
  if (props.open) schedulePreview()
})

onBeforeUnmount(() => {
  clearPreviewTimer()
  previewRequestId += 1
})
</script>

<template>
  <div
    v-if="open"
    class="basic-land-backdrop"
    role="presentation"
    @mousedown.self="closeModal"
  >
    <section
      class="basic-land-modal"
      role="dialog"
      aria-modal="true"
      aria-labelledby="basic-land-modal-title"
    >
      <header class="modal-header">
        <div>
          <span class="eyebrow">Commander mana base</span>
          <h2 id="basic-land-modal-title">Adjust basic lands</h2>
          <p>
            Nonbasic lands are preserved. Mainboard basics are redistributed from
            colored mana costs and the mana sources already in the deck.
          </p>
        </div>
        <button type="button" class="close-button" :disabled="isApplying" @click="closeModal">
          Close
        </button>
      </header>

      <label class="target-field">
        <span>Total lands</span>
        <input
          v-model.number="targetLandCount"
          type="number"
          min="0"
          max="99"
          step="1"
          :disabled="isApplying"
        >
        <small>Mainboard + Commander lands. Maybeboard cards are ignored.</small>
      </label>

      <p v-if="previewError" class="state-message error">{{ previewError }}</p>
      <p v-else-if="isLoadingPreview && !preview" class="state-message">
        Calculating the mana-base preview…
      </p>

      <template v-if="preview">
        <div class="summary-grid">
          <div>
            <span>Current lands</span>
            <strong>{{ preview.current_land_count }}</strong>
          </div>
          <div>
            <span>Preserved nonbasics</span>
            <strong>{{ preview.preserved_land_count }}</strong>
          </div>
          <div>
            <span>Proposed basics</span>
            <strong>{{ preview.proposed_basic_land_count }}</strong>
          </div>
          <div>
            <span>Resulting lands</span>
            <strong>{{ preview.reachable_land_count }}</strong>
          </div>
        </div>

        <p v-if="preview.warning" class="state-message warning">
          {{ preview.warning }}
        </p>

        <section class="allocation-panel">
          <header>
            <div>
              <h3>Basic-land allocation</h3>
              <p>Existing nonbasic sources are included when balancing each color.</p>
            </div>
            <span v-if="isLoadingPreview" class="refreshing">Refreshing…</span>
          </header>

          <div class="allocation-table">
            <div class="allocation-heading">
              <span>Color</span>
              <span>Pips</span>
              <span>Other sources</span>
              <span>Current</span>
              <span>Proposed</span>
            </div>
            <div
              v-for="color in visibleColors"
              :key="color"
              class="allocation-row"
            >
              <span :class="['mana-symbol', `mana-${color.toLowerCase()}`]">{{ color }}</span>
              <span>{{ colorValue(preview.mana_demand, color) }}</span>
              <span>{{ colorValue(preview.existing_nonbasic_sources, color) }}</span>
              <span>{{ colorValue(preview.current_basics, color) }}</span>
              <strong>{{ colorValue(preview.proposed_basics, color) }}</strong>
            </div>
          </div>
        </section>
      </template>

      <footer class="modal-actions">
        <button type="button" :disabled="isApplying" @click="closeModal">Cancel</button>
        <button
          type="button"
          class="apply-button"
          :disabled="!preview || !isTargetValid || isLoadingPreview || isApplying"
          @click="applyAdjustment"
        >
          {{ isApplying ? 'Adjusting…' : preview?.target_reached === false ? 'Apply closest result' : 'Apply adjustment' }}
        </button>
      </footer>
    </section>
  </div>
</template>

<style scoped>
.basic-land-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1250;
  display: grid;
  place-items: center;
  padding: 20px;
  background: rgba(2, 6, 23, 0.78);
  backdrop-filter: blur(5px);
}

.basic-land-modal {
  width: min(760px, 96vw);
  max-height: 92vh;
  overflow: auto;
  display: grid;
  gap: 18px;
  padding: 22px;
  border: 1px solid var(--surface-border-light);
  border-radius: 22px;
  background: var(--surface-card);
  box-shadow: var(--shadow-lg);
}

.modal-header,
.allocation-panel header,
.modal-actions {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.modal-header h2,
.allocation-panel h3 {
  margin: 4px 0 0;
}

.modal-header p,
.allocation-panel p {
  margin: 6px 0 0;
  color: var(--text-secondary);
}

.eyebrow {
  color: var(--accent);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.close-button {
  flex: 0 0 auto;
}

.target-field {
  display: grid;
  grid-template-columns: minmax(120px, auto) 110px;
  align-items: center;
  gap: 8px 14px;
  padding: 14px;
  border: 1px solid var(--surface-border-light);
  border-radius: 16px;
  background: rgba(15, 23, 42, 0.55);
}

.target-field span {
  font-weight: 700;
}

.target-field input {
  width: 100%;
}

.target-field small {
  grid-column: 1 / -1;
  color: var(--text-secondary);
}

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.summary-grid > div {
  display: grid;
  gap: 4px;
  padding: 12px;
  border-radius: 14px;
  background: rgba(30, 41, 59, 0.72);
}

.summary-grid span {
  color: var(--text-secondary);
  font-size: 0.78rem;
}

.summary-grid strong {
  font-size: 1.25rem;
}

.state-message {
  margin: 0;
  padding: 11px 13px;
  border-radius: 12px;
  background: rgba(59, 130, 246, 0.12);
}

.state-message.error {
  color: var(--error-text, #fecaca);
  background: rgba(220, 38, 38, 0.16);
}

.state-message.warning {
  color: #fde68a;
  background: rgba(217, 119, 6, 0.16);
}

.allocation-panel {
  display: grid;
  gap: 12px;
}

.refreshing {
  color: var(--text-secondary);
  font-size: 0.82rem;
}

.allocation-table {
  overflow-x: auto;
  border: 1px solid var(--surface-border-light);
  border-radius: 14px;
}

.allocation-heading,
.allocation-row {
  display: grid;
  grid-template-columns: minmax(60px, 0.8fr) repeat(4, minmax(78px, 1fr));
  align-items: center;
  gap: 8px;
  padding: 10px 12px;
}

.allocation-heading {
  color: var(--text-secondary);
  font-size: 0.75rem;
  font-weight: 700;
  background: rgba(15, 23, 42, 0.8);
}

.allocation-row + .allocation-row {
  border-top: 1px solid var(--surface-border-light);
}

.mana-symbol {
  width: 30px;
  height: 30px;
  display: inline-grid;
  place-items: center;
  border-radius: 50%;
  color: #0f172a;
  font-weight: 900;
}

.mana-w { background: #f5f0d8; }
.mana-u { background: #7dd3fc; }
.mana-b { color: #f8fafc; background: #334155; }
.mana-r { background: #fb7185; }
.mana-g { background: #86efac; }
.mana-c { background: #cbd5e1; }

.modal-actions {
  justify-content: flex-end;
  padding-top: 4px;
}

.apply-button {
  border-color: rgba(34, 197, 94, 0.55);
  background: rgba(22, 163, 74, 0.24);
}

@media (max-width: 650px) {
  .summary-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .allocation-heading,
  .allocation-row {
    grid-template-columns: 52px repeat(4, minmax(65px, 1fr));
    font-size: 0.82rem;
  }
}
</style>
